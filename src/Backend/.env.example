# ============================
# WealthCommand Backend — .env.example
# ============================
# Copy file này thành .env và điền giá trị thực tế vào
# File .env KHÔNG được commit lên git

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Múi giờ hệ thống (Chuẩn GMT+7 Việt Nam cho Cloud Server)
TZ=Asia/Ho_Chi_Minh
# Cờ cho phép nhận mock extraction/user khi chạy test/dev (chỉ có hiệu lực khi NODE_ENV != 'production')
ALLOW_MOCK_INPUT=false

# PostgreSQL (Prisma)
# DATABASE_URL: dùng cho query thông thường (có thể qua PgBouncer/pooler)
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# ⚠️ BẮT BUỘC THÊM — DIRECT_URL cần thiết để chạy `prisma migrate` và `prisma studio`
# Nếu không có local pooler: dùng cùng giá trị với DATABASE_URL
# Nếu dùng Supabase/PgBouncer: dùng connection string trực tiếp (port 5432, không phải 6543)
DIRECT_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public"

# Chỉ dùng cho `npm test*`: CSDL thử TRÊN MÁY NÀY (máy khác thì rào chắn từ chối chạy). Bộ test không đọc DATABASE_URL ở trên.
# Không đặt thì các test cần CSDL thật sẽ đỏ vì không kết nối được; không có gì bị ghi ra ngoài.
# TEST_DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5432/flowmoney_kiem_thu"

# Redis & BullMQ Queue Tuning (Tối ưu tiết kiệm lệnh Upstash Redis)
REDIS_URL=redis://localhost:6379
BULLMQ_STALLED_INTERVAL_MS=300000  # 5 phút (300.000ms) - tần suất kiểm tra job kẹt
BULLMQ_DRAIN_DELAY_SEC=5           # 5 giây - thời gian nghỉ khi queue rỗng
BULLMQ_LOCK_DURATION_MS=60000      # 60 giây - thời gian giữ khóa job

# JWT Secrets — THAY BẰNG GIÁ TRỊ NGẪU NHIÊN KHI LÊN PROD
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# ============================
# Mã hóa dữ liệu At-Rest (Nghị định 13/2023/NĐ-CP & PCI-DSS v4.0)
# ============================
# BẮT BUỘC ở production — thiếu biến này sẽ từ chối khởi động
# Sinh khoá ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=your_64char_hex_key_here

# BLIND_INDEX_SECRET dùng cho HMAC-SHA256 tra soát dữ liệu mã hoá (tìm kiếm an toàn)
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLIND_INDEX_SECRET=your_blind_index_secret_here
# Số ngày giữ IP đầy đủ (bản mã + chỉ mục mù) ở lịch sử thiết bị và bảng cách ly AIOps; quá hạn thì job 0h00 xóa (Data_Security.md 10.8)
IP_RETENTION_DAYS=365

# JWT Expiry
JWT_ADMIN_ACCESS_EXPIRES=15m
JWT_ADMIN_REFRESH_EXPIRES=7d
JWT_USER_ACCESS_EXPIRES=7d
JWT_USER_REFRESH_EXPIRES=90d

# CORS — Hỗ trợ nhiều origin phân cách bằng dấu phẩy (Client-app, Admin-web, Localhost)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:9090,https://managementfinance.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# AIOps Sentinel — Danh sách IP Admin tin cậy tĩnh (Phân cách bởi dấu phẩy)
ADMIN_TRUSTED_IPS=127.0.0.1,::1,localhost

# ============================
# SePay Bank Hub Configuration
# ============================
SEPAY_BANKHUB_API_URL=https://bankhub-api.sepay.vn
SEPAY_CLIENT_ID=your_sepay_client_id_here
SEPAY_CLIENT_SECRET=your_sepay_client_secret_here
SEPAY_COMPANY_XID=your_sepay_company_uuid_here
SEPAY_WEBHOOK_API_KEY=dsg

# ============================
# Google Gemini AI (OCR & LLM Classification)
# ============================
# Lấy API Key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================
# Chatbot AI — nhà cung cấp LLM riêng (DeepSeek)
# ============================
# Chỉ Chatbot AI dùng nhóm biến này; OCR và phân loại giao dịch vẫn dùng GEMINI_* ở trên.
# Không đặt CHATBOT_LLM_PROVIDER: có DEEPSEEK_API_KEY thì dùng DeepSeek, không có thì giữ Gemini.
# Lấy API Key tại: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-flash
# CHATBOT_LLM_PROVIDER=deepseek

# Giới hạn chi phí / độ dài của Chatbot AI, đã đo bằng deepseek-flash thật (2026-11-07). Mặc định (xem
# modules/ai/features/chatbot/limits/chatbot.limits.js) đã là giá trị chốt: CHỈ đặt biến dưới đây khi cần ghi đè.
# Dòng nào đã đặt trong .env sẽ THẮNG mặc định trong mã, nên đừng sao chép các giá trị cũ vào .env.
# AI_DAILY_PROMPTS_DEFAULT=20        # số lượt hỏi/ngày/người dùng khi ma trận quyền không đặt hạn mức
# AI_MONTHLY_BUDGET_MICRO_USD=800000 # ngân sách chi phí AI/người dùng/tháng (800000 = 0,80 USD)
# AI_MAX_MESSAGE_CHARS=1000
# AI_MAX_OUTPUT_TOKENS=1024
# AI_MAX_HISTORY_ITEMS=4
# AI_MAX_HISTORY_ITEM_CHARS=800
# AI_MAX_TOOL_RESULT_CHARS=2500
# AI_MAX_TOOL_ROUNDS=5               # gọi công cụ đa bước là mặc định; 1 = một bước (chỉ để so sánh)
# AI_MAX_TOOL_CALLS_PER_ROUND=5
# AI_MAX_TURN_COST_MICRO_USD=12000   # trần CỨNG chi phí một lượt (0,012 USD); vượt thì thôi gọi công cụ, vẫn trả lời
# AI_TURN_COST_FACTOR=1.5            # trần động = hệ số × ngân sách còn lại ÷ (số ngày còn lại × số lượt mỗi ngày)
# AI_MIN_TURN_COST_MICRO_USD=2000    # sàn của trần động, giữ cho lượt thường không bị cắt
# AI_MAX_STREAMS_PER_USER=1
# AI_MAX_STREAMS_GLOBAL=30
# Bảng giá để tính chi phí (USD / 1 triệu token). Mặc định = giá GIỜ CAO ĐIỂM của deepseek-flash (bảo thủ).
# AI_PRICE_MISS_PER_M=0.30
# AI_PRICE_HIT_PER_M=0.006
# AI_PRICE_OUT_PER_M=1.20

# ============================
# Cổng thanh toán PayOS (VietQR / Chuyển khoản)
# ============================
# Lấy thông tin tại: https://my.payos.vn -> Kênh thanh toán -> Thông tin tích hợp
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_RETURN_URL=https://managementfinance-admin.vercel.app/payment/success
PAYOS_CANCEL_URL=https://managementfinance-admin.vercel.app/payment/cancel
PREMIUM_PRICE_VND=49000
PREMIUM_PACKAGE_DAYS=30

# ============================
# Bảo Mật & Mã Hóa Dữ Liệu (AES-256-GCM)
# ============================
# CSDL dev cục bộ PersonFinance chạy với DATA_ENCRYPTION_KEY = khoá dev mặc định của utils/crypto.util.js (đặt qua biến môi trường của tiến trình, không sửa .env). Khoá trong .env là của Supabase. Không trộn hai khoá trên một CSDL.
DATA_ENCRYPTION_KEY=


# ============================
# Kho lưu trữ tệp (Supabase Storage)
# ============================
# Có đủ SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY thì lưu tệp lên Supabase Storage (bucket riêng tư refund-proofs, data-exports).
# Thiếu khóa (dev, test) thì lưu ở src/Backend/Assets/Storage. Production thiếu khóa sẽ ghi log lỗi vì ổ đĩa Render mất khi deploy lại.
# SERVICE_ROLE_KEY là khóa bí mật toàn quyền: chỉ đặt ở Backend (Render), không đưa vào Admin-web hay Client-app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_DRIVER=local   # ép dùng ổ đĩa cục bộ dù có khóa
