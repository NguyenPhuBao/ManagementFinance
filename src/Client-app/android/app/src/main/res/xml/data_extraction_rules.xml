<?xml version="1.0" encoding="utf-8"?>
<!-- Không sao lưu, không chuyển máy (2026-10-24, siết bảo mật đợt 2) — manifest trỏ tệp này qua
     android:dataExtractionRules, cạnh android:allowBackup="false". Server là bản gốc: đổi máy thì đăng nhập lại và kéo
     dữ liệu đã đồng bộ về. `test/core/bao_mat_manifest_test.dart` canh đủ mọi vùng ở cả hai khối. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
