<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SPIKE C4 (2026-10-01) — CHỈ bản debug. Màn đo `spike_c4_page.dart` (sau cờ
         SPIKE_C4) cần micro cho hai lối giọng nói, và trên Android 11+ app phải khai
         <queries> mới thấy dịch vụ nhận dạng giọng nói của máy. Đặt ở manifest debug
         để bản release không xin thêm quyền nào cho một phép đo; khi spike có kết
         luận thì quyền của lối được chọn mới vào manifest chính. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
