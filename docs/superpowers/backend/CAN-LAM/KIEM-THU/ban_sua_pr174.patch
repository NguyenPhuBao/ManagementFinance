+ * cho chủ tài khoản vẫn giữ số đầy đủ. Không sửa object gốc.
+ * @param {object|null} obj
+ * @param {string[]} khoa
+ * @returns {object|null}
+ */
+function maskAccountFields(obj, khoa) {
+  if (!obj) return obj ?? null;
+  const ra = { ...obj };
+  for (const k of khoa) {
+    if (ra[k]) ra[k] = maskAccountNumber(String(ra[k]));
+  }
+  return ra;
+}
