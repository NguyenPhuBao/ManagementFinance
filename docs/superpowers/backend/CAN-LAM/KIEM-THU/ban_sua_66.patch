+async function confirmUpgradeByAdmin(req, res, next) {
+  try {
+    const { orderCode } = req.params;
+    const { accept } = req.body || {};
+    if (!/^\d+$/.test(orderCode)) {
+      return ResponseHandler.badRequest(res, 'Mã đơn hàng không hợp lệ');
